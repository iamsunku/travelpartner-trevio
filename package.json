{
  "name": "travelpro",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=travelpro-frontend",
    "dev:frontend": "npm run dev --workspace=travelpro-frontend",
    "dev:backend": "npm run dev --workspace=travelpro-backend",
    "build:frontend": "npm run build --workspace=travelpro-frontend",
    "start:backend": "npm run start --workspace=travelpro-backend",
    "db:generate": "npm run db:generate --workspace=travelpro-backend",
    "db:push": "npm run db:push --workspace=travelpro-backend",
    "db:seed": "npm run db:seed --workspace=travelpro-backend"
  }
}
