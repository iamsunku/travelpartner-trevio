DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="1d"
PORT=4000
NODE_ENV="production"
CORS_ORIGIN="https://your-frontend.vercel.app,http://localhost:3000"

# Reserved for a future file-upload feature (agency logos, invoices) — not required today,
# no code depends on this yet.
# CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud_name>"

# Optional: enables real payment collection via Razorpay. Without these, booking
# checkouts across the app automatically fall back to a simulated "demo mode" payment.
# Get test-mode keys free at https://dashboard.razorpay.com/app/keys (no business
# verification needed for test mode; live mode requires PAN + bank account).
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
