# Transaction pooler (app runtime) — port 6543
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (migrations) — port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="1d"
PORT=4000
NODE_ENV="production"
CORS_ORIGIN="https://your-frontend.vercel.app"

# Private document storage. Default is local files under backend/storage/private-documents.
# Those files are not served as public static URLs. Access is only through authorized APIs.
# DOCUMENT_STORAGE="local"
# DOCUMENT_STORAGE_DIR=""
# DOCUMENT_MAX_BYTES="10485760"
# GST/VAT proof is always capped at 5 MB (JPG, PNG, PDF).
# DOCUMENT_GST_MAX_BYTES="5242880"
# S3-compatible storage is optional. Nothing is hardcoded to a production provider.
# Requires the @aws-sdk/client-s3 package when DOCUMENT_STORAGE=s3.
# DOCUMENT_STORAGE="s3"
# DOCUMENT_S3_BUCKET=""
# DOCUMENT_S3_REGION=""
# DOCUMENT_S3_ENDPOINT=""
# DOCUMENT_S3_ACCESS_KEY_ID=""
# DOCUMENT_S3_SECRET_ACCESS_KEY=""

# --- Payments (Razorpay) ---
# Required for live checkout in production. Without keys, payment endpoints return
# configured:false. Demo/simulated success is OFF when NODE_ENV=production unless
# ALLOW_DEMO_PAYMENTS=true (never enable that on a real customer environment).
# Get test keys at https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# ALLOW_DEMO_PAYMENTS="false"
# RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"
# Closed launch — set true only if agencies may self-register
# ALLOW_PUBLIC_REGISTRATION="false"

# --- Email (SMTP or SendGrid) ---
# Required for forgot-password + new-user credential emails in production.
# Without these, emails are logged only and forgot-password will not return a
# plaintext password when NODE_ENV=production.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@yourdomain.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_SECURE="false"
# SMTP_FROM="you@yourdomain.com"
# SENDGRID_API_KEY="SG.xxxxxxxx"
# SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
#
# Quotation PDF email (Phase 6) uses the same SMTP/SendGrid settings.
# It never reports production success when email is unconfigured.
# For automated tests only:
# QUOTATION_EMAIL_PROVIDER="capture"
# QUOTATION_DELIVERY_PROVIDER="capture"

# --- WhatsApp quotation delivery (Phase 6) ---
# Choose Meta Cloud API and/or Twilio. Unconfigured providers fail clearly.
# QUOTATION_WHATSAPP_PROVIDER="auto"   # auto | meta | twilio | capture
# Meta Cloud API:
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_API_VERSION="v21.0"
# Twilio WhatsApp:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional HMAC secret for short-lived Twilio media fetch tokens:
# DELIVERY_MEDIA_SECRET=""

# --- Quotation expiry automation (Phase 8) ---
# Server-side poller transitions eligible quotes to Expired when validTill < UTC today.
# QUOTE_EXPIRY_SCHEDULER="true"   # set "false" to disable the in-process poller
# QUOTE_EXPIRY_POLL_MS="60000"    # minimum enforced 10000
# QUOTE_EXPIRY_STARTUP_DELAY_MS="5000"
# Admins can still POST /api/quotations/expire-due. List load also runs an opportunistic pass.

# --- Quotation expiry reminder emails (Phase 17 / EXP-02) ---
# Original EXP-02 requires a pre-expiry email but does not specify lead time.
# Default: remind when validTill is within the next N UTC calendar days (inclusive),
# including the validity day itself (still valid per Phase 8 same-day rule).
# QUOTE_EXPIRY_REMINDER_ENABLED="true"   # set "false" to disable reminder emails only
# QUOTE_EXPIRY_REMINDER_DAYS_BEFORE="3"  # 0 = remind only on validTill day; max 90
# Uses the same Phase 6 SMTP/SendGrid/capture email provider. Unconfigured email
# records NotConfigured — never reports fake success. Idempotent via QuotationExpiryReminder.

# --- Customer quotation response links (Phase 9) ---
# Frontend origin used in email/WhatsApp customer response URLs (/q/:token).
# Falls back to CORS_ORIGIN first entry when unset.
# PUBLIC_APP_ORIGIN="http://localhost:3100"

# Dev/test only — never set true in production:
# ALLOW_INSECURE_TEMP_PASSWORD_RESPONSE="false"

# Seed passwords (local/dev only). Never commit real values. At least 12 characters.
# If unset, prisma/seed.ts prints a one-time password and does not write it to source.
# SEED_DEMO_PASSWORD=""
# SEED_SUPER_ADMIN_PASSWORD=""
# SEED_DEV_PASSWORD=""
