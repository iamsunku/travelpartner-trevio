// Travel Partner Pro — Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  password     String?
  role         String   @default("employee") // super_admin|agency_admin|branch_manager|employee|accountant|customer
  designation  String?
  agencyId     String?
  branchId     String?
  avatar       String?
  status       String   @default("Active")
  permissions  Json?    // null = use role default; array of module keys = explicit override
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency       Agency?  @relation(fields: [agencyId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
  bookings     Booking[]
  leads        Lead[]
  tasks        Task[]   @relation("TaskAssignee")
  quotations   Quotation[]
  auditLogs    AuditLog[]
  paymentsCollected Payment[]
  attendance   Attendance[]
  leaves       Leave[]  @relation("LeaveOwner")
  approvedLeaves Leave[] @relation("LeaveApprover")

  @@index([agencyId])
  @@index([branchId])
}

model Agency {
  id              String   @id @default(cuid())
  name            String
  owner           String
  email           String
  phone           String
  plan            String   @default("Starter") // Starter|Growth|Enterprise
  status          String   @default("Active")  // Active|Suspended|Trial
  walletBalance   Int      @default(0)
  commissionEarned Int     @default(0)
  totalBookings   Int      @default(0)
  monthlyRevenue  Int      @default(0)
  apiAllocation   Json     @default("{}") // {flights,hotels}
  gstNumber       String?
  panNumber       String?
  address         String?
  logo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  branches        Branch[]
  bookings        Booking[]
}

model Branch {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  manager   String
  city      String
  revenue   Int      @default(0)
  createdAt DateTime @default(now())

  agency    Agency   @relation(fields: [agencyId], references: [id])
  users     User[]

  @@index([agencyId])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  type          String   @default("Individual") // Individual|Corporate
  tier          String   @default("Silver") // Silver|Gold|Platinum
  totalBookings Int      @default(0)
  totalSpent    Int      @default(0)
  loyaltyPoints Int      @default(0)
  passportNo    String?
  visaStatus    String?  // Valid|Expired|None
  city          String?
  agencyId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  leads         Lead[]
  travelRequirements TravelRequirement[]
  travelProposals    TravelProposal[]
}

model Booking {
  id            String   @id @default(cuid())
  bookingRef    String   @unique
  customerName  String
  customerId    String?
  service       String   // Flight|Hotel|Holiday
  route         String
  travelDate    String
  amount        Int
  commission    Int      @default(0)
  status        String   @default("Pending") // Pending|Confirmed|Ticketed|Completed|Cancelled|Refunded|Failed
  paymentStatus String   @default("Pending") // Paid|Pending|Partial|Refunded
  paymentMethod String?
  agentId       String?
  agentName     String
  agencyId      String?
  agencyName    String
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer? @relation(fields: [customerId], references: [id])
  agency        Agency?   @relation(fields: [agencyId], references: [id])
  agent         User?     @relation(fields: [agentId], references: [id])
  payments      Payment[]

  @@index([agencyId])
  @@index([customerId])
  @@index([agentId])
  @@index([branchId])
}

model Payment {
  id          String   @id @default(cuid())
  txnId       String   @unique
  customerName String
  bookingRef  String
  bookingId   String?
  agencyId    String?
  branchId    String?
  collectedById String?
  amount      Int
  method      String   // Razorpay|UPI|Card|Net Banking|Cash|Bank Transfer|Wallet
  status      String   @default("Success") // Success|Pending|Failed|Refunded
  type        String   @default("Payment") // Payment|Refund|Wallet Credit|Commission
  gateway     String?
  date        DateTime @default(now())

  booking     Booking? @relation(fields: [bookingId], references: [id])
  collectedBy User?    @relation(fields: [collectedById], references: [id])

  @@index([agencyId])
  @@index([branchId])
  @@index([collectedById])
}

model Lead {
  id           String   @id @default(cuid())
  agencyId     String?
  branchId     String?
  customerName String
  email        String
  phone        String
  source       String   // Website|WhatsApp|Phone|Walk-in|Facebook|Instagram|Google Ads|Referral
  service      String   // Flight|Hotel|Holiday
  value        Int
  stage        String   @default("New") // New|Qualified|Follow-up|Quotation Sent|Negotiation|Won|Lost
  assignedToId String?
  assignedTo   String
  expectedClose String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedToUser User?  @relation(fields: [assignedToId], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerId     String?
  travelRequirements TravelRequirement[]
  travelProposals    TravelProposal[]

  @@index([agencyId])
  @@index([branchId])
}

model Quotation {
  id         String   @id @default(cuid())
  agencyId   String?
  branchId   String?
  quoteNo    String   @unique
  customerName String
  service    String   // Flight|Hotel|Holiday|International|Activity|Transfer
  items      Int
  amount     Int
  gst        Int
  total      Int
  status     String   @default("Draft") // Draft|Sent|Accepted|Rejected|Expired
  validTill  String
  createdById String?
  createdBy  String
  isInternational Boolean @default(false)
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  destination   String?
  country       String?
  departureCity String?
  travelDates   String?
  returnDate    String?
  nights        Int?
  days          Int?
  adults        Int?
  children      Int?
  infants       Int?
  hotelStarPreference String?
  roomTypePreference  String?
  mealPlanPreference  String?
  location      String?
  budget        Int?
  currency      String   @default("INR")
  packageIncludes Json   @default("[]")
  packageExcludes Json   @default("[]")
  termsAndConditions String?
  paymentTerms    String?
  cancellationPolicy String?
  salesExecutiveName  String?
  salesExecutivePhone String?
  salesExecutiveEmail String?
  approvalStatus  String  @default("Draft") // Draft|Pending|Approved|Rejected
  lineItems       Json    @default("[]")
  createdAt  DateTime @default(now())

  createdByUser User? @relation(fields: [createdById], references: [id])

  @@index([agencyId])
  @@index([branchId])
}

model Task {
  id          String   @id @default(cuid())
  agencyId    String?
  branchId    String?
  title       String
  description String?
  assignedToId String?
  assignedTo  String
  assignedBy  String
  priority    String   @default("Medium") // Low|Medium|High|Urgent
  status      String   @default("To Do") // To Do|In Progress|Review|Completed
  dueDate     String
  relatedTo   String?
  createdAt   DateTime @default(now())

  assignee    User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([agencyId])
  @@index([branchId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  agencyId    String?
  type        String   // Credit|Debit
  source      String   // Commission|Payment|Refund|Top-up|Transfer|Booking
  amount      Int
  balance     Int
  description String
  date        DateTime @default(now())

  @@index([agencyId])
}

model Employee {
  id           String   @id @default(cuid())
  agencyId     String?
  branchId     String?
  name         String
  email        String   @unique
  phone        String
  designation  String
  department   String
  branch       String
  role         String
  status       String   @default("Active")
  salary       Int      @default(0)
  incentives   Int      @default(0)
  target       Int      @default(0)
  achieved     Int      @default(0)
  attendance   Int      @default(95)
  permissions  Json?    // null = use role default; array of module keys = explicit override (mirrors User.permissions)
  joinDate     String
  createdAt    DateTime @default(now())

  @@index([agencyId])
  @@index([branchId])
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  agencyId  String?
  branchId  String?
  date      String    // "YYYY-MM-DD"
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("Present") // Present|Absent|Half Day|On Leave
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([agencyId])
  @@index([branchId])
}

model Leave {
  id             String   @id @default(cuid())
  userId         String
  userName       String
  agencyId       String?
  branchId       String?
  type           String   // Casual|Sick|Earned|Unpaid
  fromDate       String
  toDate         String
  reason         String
  status         String   @default("Pending") // Pending|Approved|Rejected
  approvedById   String?
  approvedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation("LeaveOwner", fields: [userId], references: [id])
  approvedBy     User?    @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([agencyId])
  @@index([branchId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  agencyId  String?
  userName  String
  action    String
  module    String
  ip        String?
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([agencyId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // booking|payment|api|customer|internal|task
  title     String
  message   String
  priority  String   @default("low") // low|medium|high
  read      Boolean  @default(false)
  userId    String?
  agencyId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([agencyId])
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  name        String
  type        String   // Email|SMS|Push
  status      String   @default("Draft") // Draft|Active|Completed|Paused
  audience    String
  sentCount   Int      @default(0)
  openRate    Float    @default(0)
  clickRate   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  status      String   @default("Draft") // Published|Draft|Archived
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  status      String   @default("Draft") // Published|Draft|Archived
  author      String
  category    String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  environment String   @default("Test") // Test|Production
  status      String   @default("Active") // Active|Revoked
  calls       Int      @default(0)
  limit       Int      @default(1000)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  subject     String
  description String
  status      String   @default("Open") // Open|In Progress|Resolved|Closed
  priority    String   @default("Medium") // Low|Medium|High|Critical|Urgent
  operationsType String @default("general_inquiry") // routes to department
  deliveryType   String @default("remote") // how request will be fulfilled
  department     String @default("General Support")
  scheduledAt    DateTime? // when deliveryType = scheduled
  customerName String
  customerId  String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    TicketMessage[]

  @@index([operationsType])
  @@index([deliveryType])
  @@index([department])
  @@index([status])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  sender      String
  message     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
}

model Settings {
  id          String   @id @default(cuid())
  agencyId    String   @unique
  theme       String   @default("system")
  currency    String   @default("INR")
  timezone    String   @default("Asia/Kolkata")
  notifications Boolean @default(true)
  rolePermissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Product Catalog ──────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  agencyId    String?
  name        String
  contactPerson String?
  email       String?
  phone       String?
  type        String   // Hotel|Activity|Transfer|General
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotels      HotelProduct[]
  activities  ActivityProduct[]
  transfers   TransferProduct[]

  @@index([agencyId])
}

model HotelProduct {
  id              String   @id @default(cuid())
  agencyId        String?
  supplierId      String?
  destinationId   String?
  name            String
  description     String?
  starCategory    Int      @default(3)
  address         String?
  city            String
  country         String   @default("India")
  mapsUrl         String?
  amenities       Json     @default("[]")
  policies        Json     @default("{}")
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("11:00")
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  website         String?
  images          Json     @default("[]")
  roomCategories  Json     @default("[]") // [{ name, description, images, maxOccupancy, maxAdults, maxChildren, extraBedAllowed, roomSize, bedType, mealPlan, smoking, pricing:{single,double,triple,quad,extraAdult,extraChild}, weekdayPricing, weekendPricing }]
  contractStart   String?
  contractEnd     String?
  childPolicy     Json     @default("{}") // { withBed, withoutBed }
  currency        String   @default("INR")
  cancellationPolicy String?
  blackoutDates   Json     @default("[]") // [{ label, dateFrom, dateTo }]
  inventory       Json     @default("[]") // [{ roomName, date, available, soldOut, closed }]
  status          String   @default("Active") // Active|Archived|Draft
  approvalStatus  String   @default("Draft") // Draft|Pending|Approved|Rejected
  pendingRateChanges Json? // staged rate fields awaiting admin approval
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  destination     Destination? @relation(fields: [destinationId], references: [id])
  packageHotels     PackageHotel[]

  @@index([agencyId])
  @@index([destinationId])
  @@index([city])
  @@index([status])
  @@index([approvalStatus])
}

model ActivityProduct {
  id              String   @id @default(cuid())
  agencyId        String?
  supplierId      String?
  destinationId   String?
  name            String
  description     String?
  images          Json     @default("[]")
  duration        String?
  location        String?
  meetingPoint    String?
  inclusions      Json     @default("[]")
  exclusions      Json     @default("[]")
  operatingHours  String?
  minChildAge     Int?
  adultPrice      Int      @default(0)
  childPrice      Int      @default(0)
  infantPrice     Int?
  currency        String   @default("INR")
  blackoutDates   Json     @default("[]")
  rateValidFrom   String?
  rateValidTo     String?
  cancellationPolicy String?
  transferOptions   Json     @default("[]") // [{ transferProductId, label }] bundled transfer choices for agents
  status          String   @default("Active") // Active|Draft|Archived
  approvalStatus  String   @default("Draft") // Draft|Pending|Approved|Rejected
  pendingRateChanges Json? // staged rate fields awaiting admin approval
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  destination     Destination? @relation(fields: [destinationId], references: [id])
  packageActivities PackageActivity[]

  @@index([agencyId])
  @@index([destinationId])
  @@index([status])
  @@index([approvalStatus])
}

model TransferProduct {
  id              String   @id @default(cuid())
  agencyId        String?
  supplierId      String?
  destinationId   String?
  name            String
  transferType    String   // Private|Shared|Both
  vehicleType     String?
  pickupLocation  String
  dropLocation    String
  pickupTime      String?
  waitingCharges  Int?
  privatePrice    Int?
  sharedPrice     Int?
  sharedAdultPrice Int?
  sharedChildPrice Int?
  vehiclePricing  Json     @default("[]") // [{ vehicleType, seats, price }] for private transfers
  currency        String   @default("INR")
  rateValidFrom   String?
  rateValidTo     String?
  blackoutDates   Json     @default("[]")
  cancellationPolicy String?
  status          String   @default("Active") // Active|Draft|Archived
  approvalStatus  String   @default("Draft") // Draft|Pending|Approved|Rejected
  pendingRateChanges Json? // staged rate fields awaiting admin approval
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  destination     Destination? @relation(fields: [destinationId], references: [id])
  packageTransfers  PackageTransfer[]

  @@index([agencyId])
  @@index([destinationId])
  @@index([status])
  @@index([approvalStatus])
}

model CustomerDocument {
  id          String   @id @default(cuid())
  customerId  String
  agencyId    String?
  name        String
  type        String   // Passport|PAN|Aadhaar|Visa|Other
  url         String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([agencyId])
}

model EmployeeActivitySnapshot {
  id                String   @id @default(cuid())
  userId            String
  agencyId          String?
  date              String   // YYYY-MM-DD
  loginAt           DateTime?
  logoutAt          DateTime?
  workingMinutes    Int      @default(0)
  customersAdded    Int      @default(0)
  quotationsCreated Int      @default(0)
  productsAdded     Int      @default(0)
  productsUpdated   Int      @default(0)
  revenueGenerated  Int      @default(0)
  lastActivity      String?
  ipAddress         String?
  deviceUsed        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
  @@index([agencyId])
}

// ── Performance Analytics ────────────────────────────────────────────────────

model ApiMetric {
  id            String   @id @default(cuid())
  endpoint      String   // /api/products, /api/auth/login, etc
  method        String   // GET, POST, PUT, DELETE, PATCH
  statusCode    Int
  responseTime  Int      // milliseconds
  userId        String?
  agencyId      String?
  errorMessage  String?
  queryTime     Int?     // database query time in ms
  createdAt     DateTime @default(now())

  @@index([endpoint])
  @@index([method])
  @@index([statusCode])
  @@index([userId])
  @@index([agencyId])
  @@index([createdAt])
}

model PerformanceMetric {
  id            String   @id @default(cuid())
  metric        String   // cpu_usage, memory_usage, request_count, error_count, etc
  value         Float
  unit          String   // %, MB, count, etc
  date          String   // YYYY-MM-DD
  hour          Int      // 0-23
  createdAt     DateTime @default(now())

  @@unique([metric, date, hour])
  @@index([metric])
  @@index([date])
}

model Destination {
  id                 String    @id @default(uuid())
  agencyId           String?
  branchId           String?

  name               String
  country            String
  region             String?
  city               String?
  slug               String
  shortDescription   String?
  longDescription    String?   @db.Text

  currency           String    @default("INR")
  language           String?
  timeZone           String?
  visaRequired       Boolean   @default(false)
  visaDetails        String?   @db.Text
  passportValidity   String?
  bestTimeToVisit    String?
  climate            String?
  averageBudget      String?

  popularAttractions Json      @default("[]")
  localTransport     String?   @db.Text
  foodSpecialities   Json      @default("[]")
  shopping           String?   @db.Text
  nightlife          String?   @db.Text
  adventureActivities Json     @default("[]")
  familyFriendly     Boolean   @default(true)
  coupleFriendly     Boolean   @default(true)
  seniorFriendly     Boolean   @default(false)

  heroImage          String?
  galleryImages      Json      @default("[]")
  bannerImage        String?
  thumbnail          String?
  videoUrl           String?
  imageAltText       String?

  seoTitle           String?
  seoDescription     String?
  keywords           Json      @default("[]")

  status             String    @default("Draft") // Draft|Active|Inactive|Archived
  metadata           Json      @default("{}")

  createdById        String?
  updatedById        String?
  createdByName      String?
  updatedByName      String?

  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  hotelProducts      HotelProduct[]
  activityProducts   ActivityProduct[]
  transferProducts   TransferProduct[]
  travelPackages     TravelPackage[]
  travelRequirements TravelRequirement[]

  @@unique([agencyId, slug])
  @@index([agencyId])
  @@index([branchId])
  @@index([country])
  @@index([region])
  @@index([status])
  @@index([deletedAt])
}

model TravelPackage {
  id               String    @id @default(uuid())
  agencyId         String?
  branchId         String?
  packageCode      String
  packageName      String
  destinationId    String
  durationDays     Int       @default(1)
  durationNights   Int       @default(0)
  packageType      String    @default("Standard")
  description      String?   @db.Text
  highlights       Json      @default("[]")
  status           String    @default("Draft") // Draft|Published|Archived
  startingPrice    Int       @default(0)
  currency         String    @default("INR")
  heroImage        String?
  bannerImage      String?
  isFeatured       Boolean   @default(false)
  hotelCost        Int       @default(0)
  activityCost     Int       @default(0)
  transferCost     Int       @default(0)
  markup           Int       @default(0)
  tax              Int       @default(0)
  discount         Int       @default(0)
  finalPrice       Int       @default(0)
  currentVersion   Int       @default(1)
  metadata         Json      @default("{}")
  createdById      String?
  updatedById      String?
  createdByName    String?
  updatedByName    String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  destination      Destination @relation(fields: [destinationId], references: [id])
  hotels           PackageHotel[]
  activities       PackageActivity[]
  transfers        PackageTransfer[]
  versions         PackageVersion[]
  days             PackageDay[]
  productOptions   PackageProductOption[]

  @@unique([agencyId, packageCode])
  @@index([agencyId])
  @@index([destinationId])
  @@index([status])
  @@index([packageType])
  @@index([isFeatured])
  @@index([deletedAt])
}

model PackageHotel {
  id             String        @id @default(cuid())
  packageId      String
  hotelProductId String
  sortOrder      Int           @default(0)

  package        TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hotelProduct   HotelProduct  @relation(fields: [hotelProductId], references: [id])

  @@unique([packageId, hotelProductId])
  @@index([packageId])
}

model PackageActivity {
  id                String           @id @default(cuid())
  packageId         String
  activityProductId String
  sortOrder         Int              @default(0)

  package           TravelPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activityProduct   ActivityProduct  @relation(fields: [activityProductId], references: [id])

  @@unique([packageId, activityProductId])
  @@index([packageId])
}

model PackageTransfer {
  id                String           @id @default(cuid())
  packageId         String
  transferProductId String
  sortOrder         Int              @default(0)

  package           TravelPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  transferProduct   TransferProduct  @relation(fields: [transferProductId], references: [id])

  @@unique([packageId, transferProductId])
  @@index([packageId])
}

model PackageProductOption {
  id              String   @id @default(uuid())
  packageId       String
  productType     String   // HOTEL|ACTIVITY|TRANSFER
  productId       String
  optionGroup     String
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  priceAdjustment Int      @default(0)
  status          String   @default("Active") // Active|Inactive
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  package         TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, productType, productId])
  @@index([packageId])
  @@index([packageId, productType, optionGroup])
}

model PackageVersion {
  id             String        @id @default(cuid())
  packageId      String
  versionNumber  Int
  snapshot       Json
  changeSummary  String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime      @default(now())

  package        TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, versionNumber])
  @@index([packageId])
}

model PackageDay {
  id          String   @id @default(uuid())
  packageId   String
  dayNumber   Int
  title       String
  description String?  @db.Text
  mealPlan    Json     @default("{}")
  coverImage  String?
  gallery     Json     @default("[]")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  items       PackageTimelineItem[]

  @@unique([packageId, dayNumber])
  @@index([packageId])
}

model PackageTimelineItem {
  id          String   @id @default(uuid())
  packageDayId String
  itemType    String   // HOTEL|ACTIVITY|TRANSFER|TEXT
  referenceId String?
  optionGroup String?
  title       String
  description String?  @db.Text
  startTime   String?
  endTime     String?
  sortOrder   Int      @default(0)
  icon        String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  day         PackageDay @relation(fields: [packageDayId], references: [id], onDelete: Cascade)

  @@index([packageDayId])
  @@index([itemType])
}

model TravelRequirement {
  id                 String    @id @default(uuid())
  agencyId           String?
  branchId           String?
  requirementCode    String
  customerId         String?
  leadId             String?
  destinationId      String
  travelStartDate    DateTime
  travelEndDate      DateTime
  days               Int       @default(1)
  nights             Int       @default(0)
  adults             Int       @default(1)
  children           Int       @default(0)
  infants            Int       @default(0)
  budgetMin          Int       @default(0)
  budgetMax          Int       @default(0)
  hotelCategory      String?
  packageType        String?
  preferredMealPlan  Json      @default("{}")
  preferredTransfer  String?
  flightRequired     Boolean   @default(false)
  visaRequired       Boolean   @default(false)
  insuranceRequired  Boolean   @default(false)
  specialRequests    String?   @db.Text
  status             String    @default("Draft") // Draft|Qualified|Quoted|Booked|Cancelled
  selectedPackageId  String?
  markup             Int       @default(0)
  metadata           Json      @default("{}")
  createdById        String?
  updatedById        String?
  createdByName      String?
  updatedByName      String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer           Customer?   @relation(fields: [customerId], references: [id])
  lead               Lead?       @relation(fields: [leadId], references: [id])
  destination        Destination @relation(fields: [destinationId], references: [id])
  selections         TravelRequirementSelection[]
  history            TravelRequirementHistory[]
  travelProposals    TravelProposal[]

  @@unique([agencyId, requirementCode])
  @@index([agencyId])
  @@index([customerId])
  @@index([leadId])
  @@index([destinationId])
  @@index([status])
  @@index([deletedAt])
}

model TravelRequirementSelection {
  id                   String   @id @default(uuid())
  requirementId        String
  packageId            String
  hotelOptionGroup     String?
  activityOptionGroup  String?
  transferOptionGroup  String?
  markup               Int      @default(0)
  hotelCost            Int      @default(0)
  activityCost         Int      @default(0)
  transferCost         Int      @default(0)
  sellingPrice         Int      @default(0)
  matchScore           Float?
  matchReasons         Json     @default("[]")
  isSelected           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  requirement          TravelRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, packageId])
  @@index([requirementId])
  @@index([packageId])
}

model TravelRequirementHistory {
  id             String   @id @default(uuid())
  requirementId  String
  action         String
  summary        String?
  createdByName  String?
  createdAt      DateTime @default(now())

  requirement    TravelRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
}

model QuoteTemplate {
  id              String    @id @default(uuid())
  agencyId        String?
  templateName    String
  description     String?   @db.Text
  theme           String    @default("Classic")
  primaryColor    String    @default("#2A7BBD")
  secondaryColor  String    @default("#00A79D")
  fontFamily      String    @default("Inter")
  logo            String?
  watermark       String?
  headerStyle     Json      @default("{}")
  footerStyle     Json      @default("{}")
  pageSize        String    @default("A4")
  orientation     String    @default("portrait")
  backgroundImage String?
  showPageNumbers Boolean   @default(true)
  isDefault       Boolean   @default(false)
  status          String    @default("Draft") // Draft|Active|Archived
  createdById     String?
  updatedById     String?
  createdByName   String?
  updatedByName   String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sections        QuoteTemplateSection[]
  history         QuoteTemplateHistory[]

  @@index([agencyId])
  @@index([status])
  @@index([deletedAt])
}

model QuoteTemplateSection {
  id          String   @id @default(uuid())
  templateId  String
  sectionType String
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  customTitle String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template    QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([sectionType])
}

model QuoteTemplateHistory {
  id            String   @id @default(uuid())
  templateId    String
  action        String
  summary       String?
  createdByName String?
  createdAt     DateTime @default(now())

  template      QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model AgencyBranding {
  id              String   @id @default(uuid())
  agencyId        String   @unique
  primaryColor    String   @default("#2A7BBD")
  secondaryColor  String   @default("#00A79D")
  fontFamily      String   @default("Inter")
  logo            String?
  watermark       String?
  footerText      String?
  backgroundImage String?
  headerHtml      String?  @db.Text
  showPageNumbers Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model TravelProposal {
  id                   String    @id @default(uuid())
  agencyId             String?
  proposalNumber       String
  travelRequirementId  String?
  customerId           String?
  leadId               String?
  selectedPackageId    String?
  selectedTemplateId   String?
  proposalStatus       String    @default("Draft") // Draft|Internal Review|Approved|Sent|Viewed|Accepted|Booked|Rejected|Expired|Cancelled
  currency             String    @default("INR")
  validUntil           DateTime?
  notes                String?   @db.Text
  internalNotes        String?   @db.Text
  currentVersion       Int       @default(1)
  pdfUrl               String?
  pdfGeneratedAt       DateTime?
  pdfVersion           Int?
  createdById          String?
  updatedById          String?
  createdByName        String?
  updatedByName        String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer             Customer?           @relation(fields: [customerId], references: [id])
  lead                 Lead?               @relation(fields: [leadId], references: [id])
  travelRequirement    TravelRequirement?  @relation(fields: [travelRequirementId], references: [id])
  snapshots            ProposalSnapshot[]
  history              ProposalHistory[]
  pdfs                 ProposalPdf[]

  @@unique([agencyId, proposalNumber])
  @@index([agencyId])
  @@index([travelRequirementId])
  @@index([customerId])
  @@index([leadId])
  @@index([proposalStatus])
  @@index([deletedAt])
}

model ProposalPdf {
  id              String   @id @default(uuid())
  proposalId      String
  versionNumber   Int
  fileName        String
  filePath        String
  fileUrl         String
  fileSize        Int      @default(0)
  pageCount       Int      @default(0)
  generatedByName String?
  generatedAt     DateTime @default(now())

  proposal        TravelProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

model ProposalSnapshot {
  id            String   @id @default(uuid())
  proposalId    String
  versionNumber Int
  snapshot      Json
  changeSummary String?
  createdByName String?
  createdAt     DateTime @default(now())

  proposal      TravelProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

model ProposalHistory {
  id            String   @id @default(uuid())
  proposalId    String
  action        String
  summary       String?
  fromStatus    String?
  toStatus      String?
  versionNumber Int?
  createdByName String?
  createdAt     DateTime @default(now())

  proposal      TravelProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

