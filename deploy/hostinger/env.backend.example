# Copy to /var/www/treviogobal/backend/.env and fill real values.
# Never commit the real .env file.

NODE_ENV=production
PORT=4000

# Supabase Postgres (transaction pooler + session/direct)
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Long random string (32+ chars). Required in production.
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN=1d

# Public site origins (comma-separated, no trailing slash)
CORS_ORIGIN="https://www.treviogobal.com,https://treviogobal.com"
PUBLIC_APP_ORIGIN="https://www.treviogobal.com"

ALLOW_DEMO_PAYMENTS=false
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_INSECURE_TEMP_PASSWORD_RESPONSE=false

# Optional — payments
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional — email (forgot-password / quotation PDF)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_FROM=
